new file mode 100644
index 0000000..f6c2faa
--- /dev/null
+++ b/src/utils/addressController.ts
@@ -0,0 +1,52 @@
+import type { ControllerItem, ControllerType } from '@/types/interface';
+import type { SavedDeviceInfo } from '@/types/config';
+import type { EndPlayDesktopControllerConfig, PlayCoverControllerConfig } from '@/types/maa';
+import { buildPlayCoverControllerConfig } from './playCoverController';
+
+export function isAddressControllerType(
+  type: ControllerType | undefined,
+): type is 'PlayCover' | 'EndPlayDesktop' {
+  return type === 'PlayCover' || type === 'EndPlayDesktop';
+}
+
+export function getSavedControllerAddress(
+  type: ControllerType | undefined,
+  savedDevice: SavedDeviceInfo | undefined,
+): string | undefined {
+  if (type === 'PlayCover') return savedDevice?.playcoverAddress;
+  if (type === 'EndPlayDesktop') return savedDevice?.endplaydesktopAddress;
+  return undefined;
+}
+
+export function savedControllerAddress(
+  type: 'PlayCover' | 'EndPlayDesktop',
+  address: string,
+): SavedDeviceInfo {
+  return type === 'EndPlayDesktop'
+    ? { endplaydesktopAddress: address }
+    : { playcoverAddress: address };
+}
+
+export function defaultControllerAddress(type: ControllerType | undefined): string {
+  return type === 'EndPlayDesktop' ? '127.0.0.1:1718' : '127.0.0.1:1717';
+}
+
+export function buildAddressControllerConfig(
+  controller: ControllerItem,
+  address: string,
+): EndPlayDesktopControllerConfig | PlayCoverControllerConfig {
+  if (controller.type === 'EndPlayDesktop') {
+    return {
+      type: 'EndPlayDesktop',
+      address,
+      python: controller.endplaydesktop?.python ?? '',
+      project_dir: controller.endplaydesktop?.project_dir ?? '',
+      display_short_side: controller.display_short_side,
+    };
+  }
+  return buildPlayCoverControllerConfig(
+    address,
+    controller.playcover?.uuid,
+    controller.display_short_side,
+  );
+}
