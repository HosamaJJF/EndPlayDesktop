diff --git a/tests/addressController.test.ts b/tests/addressController.test.ts
new file mode 100644
index 0000000..6bc9088
--- /dev/null
+++ b/tests/addressController.test.ts
@@ -0,0 +1,60 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  buildAddressControllerConfig,
+  defaultControllerAddress,
+  getSavedControllerAddress,
+  savedControllerAddress,
+} from '../src/utils/addressController.ts';
+
+test('EndPlayDesktop is a separate controller with explicit runtime paths', () => {
+  assert.deepEqual(
+    buildAddressControllerConfig(
+      {
+        name: 'EndPlayDesktop',
+        type: 'EndPlayDesktop',
+        display_short_side: 720,
+        endplaydesktop: { python: '/venv/bin/python', project_dir: '/project' },
+      },
+      '127.0.0.1:1718',
+    ),
+    {
+      type: 'EndPlayDesktop',
+      address: '127.0.0.1:1718',
+      python: '/venv/bin/python',
+      project_dir: '/project',
+      display_short_side: 720,
+    },
+  );
+});
+
+test('PlayCover keeps its native type even with the former reserved UUID', () => {
+  assert.deepEqual(
+    buildAddressControllerConfig(
+      { name: 'PlayCover', type: 'PlayCover', playcover: { uuid: 'maa.endplaydesktop' } },
+      '127.0.0.1:1717',
+    ),
+    {
+      type: 'PlayCover',
+      address: '127.0.0.1:1717',
+      uuid: 'maa.endplaydesktop',
+      display_short_side: undefined,
+    },
+  );
+});
+
+test('address persistence and defaults are independent for the two controllers', () => {
+  const saved = {
+    ...savedControllerAddress('PlayCover', 'playcover:1717'),
+    ...savedControllerAddress('EndPlayDesktop', 'desktop:1718'),
+  };
+  assert.equal(getSavedControllerAddress('PlayCover', saved), 'playcover:1717');
+  assert.equal(getSavedControllerAddress('EndPlayDesktop', saved), 'desktop:1718');
+  assert.equal(getSavedControllerAddress('MacOS', saved), undefined);
+  assert.equal(
+    getSavedControllerAddress('EndPlayDesktop', { playcoverAddress: 'old:1717' }),
+    undefined,
+  );
+  assert.equal(defaultControllerAddress('EndPlayDesktop'), '127.0.0.1:1718');
+  assert.equal(defaultControllerAddress('PlayCover'), '127.0.0.1:1717');
+});
diff --git a/tests/piEnv.test.ts b/tests/piEnv.test.ts
new file mode 100644
index 0000000..b703713
--- /dev/null
+++ b/tests/piEnv.test.ts
@@ -0,0 +1,36 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import type { ControllerItem, ProjectInterface } from '../src/types/interface.ts';
+
+test('PI_CONTROLLER adapts EndPlayDesktop for stock agents without changing the interface', async () => {
+  Object.defineProperty(globalThis, 'localStorage', {
+    configurable: true,
+    value: { getItem: () => null },
+  });
+  const { buildPiEnvVars } = await import('../src/utils/piEnv.ts');
+  Reflect.deleteProperty(globalThis, 'localStorage');
+  for (const controller of [
+    {
+      name: 'EndPlayDesktop',
+      type: 'EndPlayDesktop',
+      endplaydesktop: { python: '/python', project_dir: '/project' },
+    },
+    { name: 'PlayCover', type: 'PlayCover', playcover: { uuid: 'maa.endplaydesktop' } },
+    { name: 'MacOS', type: 'MacOS' },
+    { name: 'Win32-Front', type: 'Win32' },
+  ] as ControllerItem[]) {
+    const original = structuredClone(controller);
+    const env = buildPiEnvVars({
+      projectInterface: { controller: [controller], resource: [] } as unknown as ProjectInterface,
+      controllerName: controller.name,
+      resourceName: undefined,
+      translations: undefined,
+      language: 'zh-CN',
+      maaVersion: null,
+    });
+    const expected =
+      controller.type === 'EndPlayDesktop' ? { ...controller, type: 'MacOS' } : controller;
+    assert.deepEqual(JSON.parse(env.PI_CONTROLLER), expected);
+    assert.deepEqual(controller, original);
+  }
+});
